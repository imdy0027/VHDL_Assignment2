            when "011" =&gt; data &lt;= d;&#13;
            when "100" =&gt; data &lt;= e;&#13;
            when "101" =&gt; data &lt;= f;&#13;
            when "110" =&gt; data &lt;= g;&#13;
            when "111" =&gt; data &lt;= h;&#13;
            when others =&gt; data &lt;= '0';&#13;
        end case;&#13;
